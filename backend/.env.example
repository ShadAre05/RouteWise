# Local development settings. Copy to backend/.env (ignored by Git) and adjust. No real secret belongs in this file.
DATABASE_URL=postgresql+psycopg://rw_app:change_me_app@localhost:5432/routewise
# at least 32 characters; generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_characters
OSRM_BASE_URL=http://localhost:5000
LOG_LEVEL=INFO
