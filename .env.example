# Used by the root docker-compose.yml. Copy to .env (ignored by Git) and set your own values.
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=change_me_superuser
PGDATABASE=routewise
RW_OWNER_PASSWORD=change_me_owner
RW_APP_PASSWORD=change_me_app
RW_REPORTING_PASSWORD=change_me_reporting
RW_ADMIN_PASSWORD=change_me_admin
# at least 32 characters; generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_characters
OSRM_BASE_URL=http://osrm:5000
API_PORT=8000
