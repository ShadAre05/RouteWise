# Copy to .env and set your own values. .env is NOT committed (see .gitignore).
PGHOST=localhost
PGPORT=5432
PGDATABASE=routewise
# superuser: only used by scripts/bootstrap.sh (creates DB, extensions, roles)
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=change_me_superuser
# passwords of the login roles created by bootstrap (choose strong values)
RW_OWNER_PASSWORD=change_me_owner
RW_APP_PASSWORD=change_me_app
RW_REPORTING_PASSWORD=change_me_reporting
RW_ADMIN_PASSWORD=change_me_admin
