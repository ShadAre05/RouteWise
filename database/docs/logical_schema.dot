44444">fuel_level ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="refuel_saving_eur"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> refuel_saving_eur</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">numeric(7,2) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="price_date"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> price_date</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lodging_entered_eur"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> lodging_entered_eur</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">numeric(8,2) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="total_eur"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> total_eur</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">numeric(9,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">timestamptz</FONT></TD></TR></TABLE>>];
