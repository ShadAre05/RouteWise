trip_refuel_stops [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#2b2b2b"><FONT COLOR="white"><B>trip_refuel_stops</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT> id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="trip_id"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT> trip_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="seq"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> seq</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="country_code"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT> country_code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">char(2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="km_from_start"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> km_from_start</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">numeric(7,1)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="liters"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> liters</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">numeric(5,1)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="price_eur_l"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> price_eur_l</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">numeric(5,3)</FONT></TD></TR></TABLE>>];
}
