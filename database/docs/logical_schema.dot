digraph rw {
graph [rankdir=TB, fontname="Helvetica", fontsize=12, nodesep=0.5, ranksep=0.9, newrank=true, splines=true, concentrate=false, labelloc=t, pad=0.3, label="RouteWise - logical schema (PostgreSQL 16 + PostGIS). PK = primary key, FK = foreign key, ? = nullable"];
node [fontname="Helvetica", fontsize=10]; edge [color="#555555", arrowsize=0.7];
subgraph cluster_0 { label="Accounts (E1)"; style="rounded,filled"; fillcolor="#cfe3fb"; color="#888888"; fontsize=12;
users [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#2b2b2b"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT> id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> email</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">varchar(254)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> password_hash</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> role</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">user_role</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="privacy_accepted_at"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> privacy_accepted_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_changed_at"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> password_changed_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">timestamptz ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="failed_login_count"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> failed_login_count</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="locked_until"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> locked_until</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">timestamptz ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">timestamptz</FONT></TD></TR></TABLE>>];
