lodging_rates [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#2b2b2b"><FONT COLOR="white"><B>lodging_rates</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT> id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="country_code"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT> country_code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">char(2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="class"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> class</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">lodging_class</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nightly_eur"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> nightly_eur</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">numeric(7,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="checked_on"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> checked_on</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_by"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT> updated_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">uuid ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">timestamptz</FONT></TD></TR></TABLE>>];
