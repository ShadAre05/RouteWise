fuel_import_log [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#2b2b2b"><FONT COLOR="white"><B>fuel_import_log</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT> id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="started_at"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> started_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">import_status</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="bulletin_date"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> bulletin_date</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">date ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="message"><FONT POINT-SIZE="9" COLOR="#555555">  </FONT> message</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">text ?</FONT></TD></TR></TABLE>>];
